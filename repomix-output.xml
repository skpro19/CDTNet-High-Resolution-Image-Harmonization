        lut_image = np.clip(lut_image, 0, 255)

        viz_image = np.hstack((image, object_mask, target_image, lut_image, predicted_image)).astype(np.uint8)
        _save_image('reconstruction', viz_image[:, :, ::-1])

    def _load_weights(self):
        if self.cfg.weights is not None:
